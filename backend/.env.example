# NestJS application configuration
PORT=3000

# PostgreSQL connection for Prisma
# Replace CHANGE_ME with your own password in the private .env file only.
DATABASE_URL="postgresql://taskflow_user:CHANGE_ME@127.0.0.1:5434/taskflow_db?schema=public"

# JWT signing secret: generate 32 cryptographically random bytes.
# Encode them using Base64. Never commit your real secret.
JWT_SECRET=REPLACE_WITH_YOUR_32_BYTE_BASE64_SECRET
